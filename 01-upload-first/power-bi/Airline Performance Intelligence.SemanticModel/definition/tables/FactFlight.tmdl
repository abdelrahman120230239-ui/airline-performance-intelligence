table FactFlight

	column SourceRowID
		dataType: int64
		summarizeBy: none
		sourceColumn: SourceRowID

	column ReportMonth
		dataType: string
		summarizeBy: none
		sourceColumn: ReportMonth

	column FlightDate
		dataType: dateTime
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: FlightDate

		annotation UnderlyingDateTimeDataType = Date

	column CarrierID
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: CarrierID

	column FlightNumber
		dataType: string
		summarizeBy: none
		sourceColumn: FlightNumber

	column OriginAirportID
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: OriginAirportID

	column DestinationAirportID
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: DestinationAirportID

	column RouteID
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: RouteID

	column ScheduledDepartureLocal
		dataType: string
		summarizeBy: none
		sourceColumn: ScheduledDepartureLocal

	column ScheduledArrivalLocal
		dataType: string
		summarizeBy: none
		sourceColumn: ScheduledArrivalLocal

	column DepartureDelay
		dataType: int64
		summarizeBy: none
		sourceColumn: DepartureDelay

	column ArrivalDelay
		dataType: int64
		summarizeBy: none
		sourceColumn: ArrivalDelay

	column Cancelled
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Cancelled

	column Diverted
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Diverted

	column CancellationKey
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: CancellationKey

	column ArrivalOutcome
		dataType: string
		summarizeBy: none
		sourceColumn: ArrivalOutcome

	column DepartureOutcome
		dataType: string
		summarizeBy: none
		sourceColumn: DepartureOutcome

	column HasReportedCause
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: HasReportedCause

	column CarrierDelay
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: CarrierDelay

	column WeatherDelay
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: WeatherDelay

	column NASDelay
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: NASDelay

	column SecurityDelay
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: SecurityDelay

	column LateAircraftDelay
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: LateAircraftDelay

	partition FactFlight = m
		mode: import
		source =
			let
			    Source = Table.SelectColumns(stgFlights, {
			        "SourceRowID", "ReportMonth", "FlightDate", "DOT_ID_Reporting_Airline", "Flight_Number_Reporting_Airline",
			        "OriginAirportID", "DestAirportID", "RouteID", "CRSDepTime", "CRSArrTime", "DepDelay", "ArrDelay",
			        "Cancelled", "Diverted", "CancellationCode", "CarrierDelay", "WeatherDelay", "NASDelay", "SecurityDelay", "LateAircraftDelay"
			    }),
			    Renamed = Table.RenameColumns(Source, {
			        {"DOT_ID_Reporting_Airline", "CarrierID"}, {"Flight_Number_Reporting_Airline", "FlightNumber"},
			        {"DestAirportID", "DestinationAirportID"}, {"CRSDepTime", "ScheduledDepartureLocal"},
			        {"CRSArrTime", "ScheduledArrivalLocal"}, {"DepDelay", "DepartureDelay"}, {"ArrDelay", "ArrivalDelay"}
			    }),
			    Reason = Table.AddColumn(Renamed, "CancellationKey", each
			        if [Cancelled] = 0 then "-" else
			        if List.Contains({"A", "B", "C", "D"}, [CancellationCode]) then [CancellationCode] else "?", type text),
			    Arrival = Table.AddColumn(Reason, "ArrivalOutcome", each
			        if [Cancelled] = 1 then "Cancelled" else if [Diverted] = 1 then "Diverted"
			        else if [ArrivalDelay] = null then "Missing arrival delay"
			        else if [ArrivalDelay] >= 15 then "Delayed 15+"
			        else "On time", type text),
			    Departure = Table.AddColumn(Arrival, "DepartureOutcome", each
			        if [Cancelled] = 1 then "Cancelled" else if [DepartureDelay] = null then "Missing departure delay"
			        else if [DepartureDelay] >= 15 then "Delayed 15+" else "On time", type text),
			    Cause = Table.AddColumn(Departure, "HasReportedCause", each
			        [ArrivalOutcome] = "Delayed 15+" and
			        List.NonNullCount({[CarrierDelay], [WeatherDelay], [NASDelay], [SecurityDelay], [LateAircraftDelay]}) > 0, type logical),
			    Result = Table.RemoveColumns(Cause, {"CancellationCode"})
			in
			    Result
