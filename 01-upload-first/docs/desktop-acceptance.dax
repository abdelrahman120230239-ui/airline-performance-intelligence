        UNION (
            ROW ( "Check", "2025-02 / Scheduled Flights", "Actual", [Scheduled Flights], "Expected", 504884 ),
            ROW ( "Check", "2025-02 / Comparable Arrivals", "Actual", [Comparable Arrivals], "Expected", 496476 ),
            ROW ( "Check", "2025-02 / On-Time Arrivals", "Actual", [On-Time Arrivals], "Expected", 393374 ),
            ROW ( "Check", "2025-02 / Delayed Arrivals", "Actual", [Delayed Arrivals], "Expected", 103102 ),
            ROW ( "Check", "2025-02 / Comparable Departures", "Actual", [Comparable Departures], "Expected", 497479 ),
            ROW ( "Check", "2025-02 / On-Time Departures", "Actual", [On-Time Departures], "Expected", 399809 ),
            ROW ( "Check", "2025-02 / Cancelled Flights", "Actual", [Cancelled Flights], "Expected", 7405 ),
