// Paste the entire file into Power BI Desktop DAX Query View after refresh.
// Use the unrestricted model. The manual interaction and RLS checks are separate.
// Every output row should say PASS. Rate comparisons allow rounding in the source CSV.

EVALUATE
VAR Month202401 =
    CALCULATETABLE (
        UNION (
            ROW ( "Check", "2024-01 / Scheduled Flights", "Actual", [Scheduled Flights], "Expected", 547271 ),
            ROW ( "Check", "2024-01 / Comparable Arrivals", "Actual", [Comparable Arrivals], "Expected", 525370 ),
            ROW ( "Check", "2024-01 / On-Time Arrivals", "Actual", [On-Time Arrivals], "Expected", 398960 ),
            ROW ( "Check", "2024-01 / Delayed Arrivals", "Actual", [Delayed Arrivals], "Expected", 126410 ),
            ROW ( "Check", "2024-01 / Comparable Departures", "Actual", [Comparable Departures], "Expected", 526882 ),
            ROW ( "Check", "2024-01 / On-Time Departures", "Actual", [On-Time Departures], "Expected", 404943 ),
            ROW ( "Check", "2024-01 / Cancelled Flights", "Actual", [Cancelled Flights], "Expected", 20389 ),
            ROW ( "Check", "2024-01 / Diverted Flights", "Actual", [Diverted Flights], "Expected", 1512 ),
            ROW ( "Check", "2024-01 / Flights Delayed 60+ Minutes", "Actual", [Flights Delayed 60+ Minutes], "Expected", 46133 ),
            ROW ( "Check", "2024-01 / Arrival Delay Minutes 15+", "Actual", [Arrival Delay Minutes 15+], "Expected", 9538664 ),
            ROW ( "Check", "2024-01 / Reported Cause Minutes", "Actual", [Reported Cause Minutes], "Expected", 9538664 ),
            ROW ( "Check", "2024-01 / On-Time Arrival %", "Actual", [On-Time Arrival %], "Expected", 0.75938862 ),
            ROW ( "Check", "2024-01 / On-Time Departure %", "Actual", [On-Time Departure %], "Expected", 0.76856488 ),
            ROW ( "Check", "2024-01 / Cancellation %", "Actual", [Cancellation %], "Expected", 0.03725577 )
        ),
        TREATAS ( { "2024-01" }, DimDate[Year Month] )
    )

