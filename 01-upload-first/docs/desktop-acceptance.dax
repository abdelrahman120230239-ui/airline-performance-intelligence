            ROW ( "Check", "2025-01 / Comparable Arrivals", "Actual", [Comparable Arrivals], "Expected", 522269 ),
            ROW ( "Check", "2025-01 / On-Time Arrivals", "Actual", [On-Time Arrivals], "Expected", 424139 ),
